# Secrets — never commit
.env

# Python / editor / OS noise
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.DS_Store

# Generated at runtime by app.py
server.log
*.tmp          # half-written files from _atomic_write, if a save is interrupted
*.bak
*.bak.csv

# Coding data IS committed on purpose — it's the research output:
#   annotations.<coder>.json       source of truth, one file per coder
#   incident_coding.<coder>.json   incident answers, claim groups + comment
#   incident_assignments.json      shared doc -> incident map

# Derived, not committed: app.py rewrites the whole file on every save and
# nothing ever reads it back, so it carries no coding Mongo and the JSON
# above don't already have. Regenerate by saving in the app.
data_annotated.*.csv

# Backups written by docs/mongo_guide.ipynb
backup-incidents-*.json
