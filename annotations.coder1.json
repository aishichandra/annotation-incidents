        "start": 322,
        "end": 331
      },
      {
        "role": "harmed_party",
        "value": "News organization/publisher",
        "text": "Verge",
        "start": 293,
        "end": 298
      },
      {
        "role": "factor",
        "value": "Publishers’ lack of control over AI content presentation",
        "text": "We spend a lot of time trying to write headlines that are true, interesting, fun, and worthy of your attention without resorting to clickbait, but Google seems to believe we don’t have an inherent right to market our own work that way.",
        "start": 1815,
