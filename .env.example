# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=incidents

# Who may code, comma-separated. Each name gets its own annotations.<name>.json,
# incident_groups.<name>.json and data_annotated.<name>.csv, and its own subtree
# in Mongo — so coders code the same articles independently. The FIRST name owns
# any coding done before multi-coder support (the old annotations.json).
# Defaults to "coder1,coder2" if unset.
CODERS=coder1,coder2
